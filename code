    epoch_ssim = []

    for i, (sketch, real) in enumerate(train_loader):
        sketch, real = sketch.to(device), real.to(device)

        # ------------------------
        # Generate Fake Images
        # ------------------------
        fake_images = G(sketch)

        # ------------------------
        # Train Discriminator
        # ------------------------
        optimizer_D.zero_grad()
        fake_images_detached = fake_images.detach()

        real_pred = D(sketch, real)
        fake_pred = D(sketch, fake_images_detached)

        real_labels = torch.ones_like(real_pred) * 0.9
        fake_labels = torch.zeros_like(fake_pred)

        d_real_loss = criterion_GAN(real_pred, real_labels)
        d_fake_loss = criterion_GAN(fake_pred, fake_labels)
        D_loss = 0.5 * (d_real_loss + d_fake_loss)

        D_loss.backward()
        optimizer_D.step()

        # ------------------------
        # Train Generator
        # ------------------------
        optimizer_G.zero_grad()

        pred_fake = D(sketch, fake_images)
        g_adv_loss = criterion_GAN(pred_fake, torch.ones_like(pred_fake))
        g_l1_loss = criterion_L1(fake_images, real)
        g_ssim_loss = 1 - ssim(fake_images, real, data_range=2.0)
        g_perc_loss = perceptual_loss(fake_images, real)

        # Total generator loss with perceptual
        G_loss = g_adv_loss + lambda_L1 * g_l1_loss + lambda_SSIM * g_ssim_loss + lambda_perc * g_perc_loss

        G_loss.backward()
        optimizer_G.step()

        # ------------------------
        # Track Losses and SSIM
        # ------------------------
        epoch_g_loss += G_loss.item()
        epoch_d_loss += D_loss.item()
        epoch_ssim.append(1 - g_ssim_loss.item())

    avg_g_loss = epoch_g_loss / len(train_loader)
    avg_d_loss = epoch_d_loss / len(train_loader)
    avg_ssim = sum(epoch_ssim) / len(epoch_ssim)

    torch.cuda.empty_cache()

    print(f"Epoch [{epoch+1}/{epochs}] "
          f"G_loss: {avg_g_loss:.4f} D_loss: {avg_d_loss:.4f} Avg SSIM: {avg_ssim:.4f}")

    # Save best model
    if avg_ssim > best_ssim:
        best_ssim = avg_ssim
        torch.save(G.state_dict(), "best_generator.pth")

    # Step schedulers
    scheduler_G.step()
    scheduler_D.step()
import torch
import torchvision.utils as vutils
import matplotlib.pyplot as plt
from torchmetrics.functional import structural_similarity_index_measure as ssim
import os

def generate_and_show_results(G, dataset, device, save_dir="/kaggle/working/generated_results", max_show=50):
    G.eval()
    os.makedirs(save_dir, exist_ok=True)
    all_ssim = []

    with torch.no_grad():
        for i, (sketch, real) in enumerate(dataset):
            sketch_t = sketch.unsqueeze(0).to(device)
            real_t   = real.unsqueeze(0).to(device)

            # Generate fake
            fake_img = G(sketch_t)
            fake_img_clamped = torch.clamp(fake_img, -1, 1)

            # Scale to [0,1] for saving/viewing
            fake_img_save = (fake_img_clamped + 1) / 2
            real_img_save = (real_t + 1) / 2
            sketch_img_save = (sketch_t + 1) / 2

            # Save generated image
            vutils.save_image(fake_img_save, os.path.join(save_dir, f"gen_{i}.png"))

            # Compute SSIM
            batch_ssim = ssim(fake_img_clamped, real_t)
            all_ssim.append(batch_ssim.item())

            # Show images (Sketch | Fake | Real)
            if i < max_show:
                fig, axs = plt.subplots(1, 3, figsize=(12, 4))
                
                # Sketch (grayscale)
                axs[0].imshow(sketch_img_save.squeeze(0).squeeze(0).cpu(), cmap="gray")
                axs[0].set_title("Sketch")
                axs[0].axis('off')

                # Generated (RGB)
                axs[1].imshow(fake_img_save.squeeze(0).permute(1, 2, 0).cpu())
                axs[1].set_title(f"Generated\nSSIM: {batch_ssim.item():.4f}")
                axs[1].axis('off')

                # Real (RGB)
                axs[2].imshow(real_img_save.squeeze(0).permute(1, 2, 0).cpu())
                axs[2].set_title("Real")
                axs[2].axis('off')


                plt.show()

    # Print average SSIM
    avg_ssim = sum(all_ssim) / len(all_ssim)
    print(f"Generated {len(dataset)} images. Average SSIM: {avg_ssim:.4f}")
