class PairedSketchToImageDataset(Dataset):
    def __init__(self, sketch_dir, image_dir,
                 sketch_transform=None, image_transform=None,
                 include_all_sketches=True, allowed_exts=(".jpg",".jpeg",".png")):
        """
        include_all_sketches:
            True -> if multiple sketches exist for one image (e.g. -sz1, -sz2), include all pairs.
            False -> keep only one sketch per image (first found).
        """
        sketch_dir = Path(sketch_dir)
        image_dir = Path(image_dir)
        # build image map: stem (lowercase) -> path
        image_files = [p for p in image_dir.iterdir() if p.suffix.lower() in allowed_exts]
        self.image_map = {p.stem.lower(): p for p in image_files}

        sketch_files = [p for p in sketch_dir.iterdir() if p.suffix.lower() in allowed_exts]

        pairs = []
        unmatched = []

        for sk in sketch_files:
            sk_stem = sk.stem.lower().strip()

            # 1) direct heuristic: remove common sketch suffix patterns
            cand = re.sub(r'(-sz\d+|_sz\d+|-sketch|_sketch|-sk|_sk)$', '', sk_stem)
            if cand in self.image_map:
                pairs.append((str(sk), str(self.image_map[cand])))
                continue

            # 2) substring match: find image basename that is contained in sketch basename
            matches = [img_base for img_base in self.image_map.keys() if img_base in sk_stem]
            if matches:
                # choose the longest match (most specific)
                chosen = max(matches, key=len)
                pairs.append((str(sk), str(self.image_map[chosen])))
                continue

            # 3) pattern match: capture prefix like f1-001-01 or similar patterns
            m = re.match(r'([a-z0-9]+(?:-\d+)+)', sk_stem)
            if m:
                key = m.group(1)
                if key in self.image_map:
                    pairs.append((str(sk), str(self.image_map[key])))
                    continue

            # 4) fallback: try removing trailing segments after last hyphen (if that looks like sz)
            if "-" in sk_stem:
                prefix = "-".join(sk_stem.split("-")[:-1])
                if prefix in self.image_map:
                    pairs.append((str(sk), str(self.image_map[prefix])))
                    continue

            # no match found
            unmatched.append(sk)

        # If user wants only one sketch per image, reduce
        if not include_all_sketches:
            chosen = {}
            for sk, im in pairs:
                chosen.setdefault(im, sk)
            pairs = [(v,k) for k,v in chosen.items()]  # (sketch, image)

        self.pairs = pairs
        self.sketch_transform = sketch_transform
        self.image_transform = image_transform

        print(f"[Dataset] Found {len(self.pairs)} matched pairs; {len(unmatched)} unmatched sketches.")
        if unmatched:
            print("Example unmatched sketches:", [p.name for p in unmatched[:10]])

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, idx):
        sk_path, im_path = self.pairs[idx]
        sketch = Image.open(sk_path).convert("RGB")
        image  = Image.open(im_path).convert("RGB")
        if self.sketch_transform:
            sketch = self.sketch_transform(sketch)
        if self.image_transform:
            image = self.image_transform(image)
        return sketch, image

